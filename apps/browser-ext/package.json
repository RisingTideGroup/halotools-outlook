{
  "name": "halo-browser-ext",
  "version": "0.1.0",
  "private": true,
  "description": "HaloPSA browser extension — toolbar popup + inline email badges for contacts and tickets. Sibling to the Outlook add-in at the repo root.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.11",
    "@fluentui/react-icons": "^2.0.344",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.5.3",
    "vite": "^8.3.5"
  }
}
